{
	"name": "hoomban",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"verify:acl": "node scripts/verify-clinical-notes-acl.mjs && node scripts/verify-secretary-patient-access.mjs",
		"optimize:images": "node scripts/optimize-images.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/jalaali-js": "^1.2.0",
		"@types/node": "^26.4.0",
		"@types/web-push": "^3.6.4",
		"autoprefixer": "^10.5.4",
		"clsx": "^2.1.1",
		"postcss": "^8.5.26",
		"sharp": "^0.35.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.31.0",
		"bits-ui": "^2.19.0",
		"chart.js": "^4.5.1",
		"dotenv": "^17.4.2",
		"jalaali-js": "^2.0.1",
		"lucide-svelte": "^1.0.1",
		"pocketbase": "^0.27.1",
		"redis": "^6.2.1",
		"svelte-chartjs": "^4.0.1",
		"web-push": "^3.6.7"
	}
}
