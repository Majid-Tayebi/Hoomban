# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Web Push (VAPID) — generate: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hoomban.ir

# Cron endpoint for 24h appointment reminders (POST /api/cron/appointment-reminders)
CRON_SECRET=

# ZarinPal online payment (leave MERCHANT_ID empty until credentials are ready)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PUBLIC_APP_URL=http://127.0.0.1:5173
# Optional override; defaults to PUBLIC_APP_URL/api/payments/zarinpal/callback
# ZARINPAL_CALLBACK_URL=

# Optional: minimum hours before appointment for patient self-cancel (default 24)
# PATIENT_CANCEL_MIN_HOURS=24
# DEV_DEMO_AUTH=true
# DEMO_OTP=1234
