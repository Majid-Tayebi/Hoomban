# Production / Docker (scripts/install.sh generates .env)
SERVER_HOST=127.0.0.1
POCKETBASE_URL=http://pocketbase:8090
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Panel login user (created by scripts/bootstrap-developer.mjs)
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=
DEVELOPER_NAME=Developer
DEVELOPER_MOBILE=09120000099
DEVELOPER_EMAIL=developer@hoomban.local

# Web Push (VAPID) — generate: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hoomban.ir

# Cron endpoint for 24h appointment reminders (POST /api/cron/appointment-reminders)
CRON_SECRET=

# ZarinPal online payment (leave MERCHANT_ID empty until credentials are ready)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PUBLIC_APP_URL=http://127.0.0.1
# Optional override; defaults to PUBLIC_APP_URL/api/payments/zarinpal/callback
# ZARINPAL_CALLBACK_URL=

# SMS.ir — create a Sandbox key in panel: Developers → API Keys → New (type: Sandbox)
# Sandbox uses the same URL (api.sms.ir) but does NOT send real SMS or charge credit.
# Verify template in Sandbox: templateId=123456, param name=Code, text: کد تایید شما: #Code#
# SMSIR_API_KEY=              # Sandbox key for local dev; Production key for live
# SMSIR_LINE_NUMBER=3000xxxxxxx   # شماره خط اختصاصی از پنل SMS.ir — برای تأیید/یادآوری نوبت (Bulk) الزامی است
# SMSIR_TEMPLATE_OTP=123456
# SMSIR_VERIFY_PARAM=Code
# SMSIR_SANDBOX=true          # when true, OTP code is shown in UI (no real SMS)
# SMSIR_LOCAL_ONLY=true       # only dispatch when PUBLIC_APP_URL is localhost

# Optional: minimum hours before appointment for patient self-cancel (default 24)
# PATIENT_CANCEL_MIN_HOURS=24
# DEV_DEMO_AUTH=true   # NEVER enable in production (server will refuse to start)
# DEMO_OTP=1234

# Redis — distributed rate limiting + data cache in production (memory fallback in dev)
# REDIS_URL is REQUIRED when NODE_ENV=production
# REDIS_URL=redis://127.0.0.1:6379

# TRUST_PROXY=true  # Enabled automatically by scripts/install.sh behind nginx
# COOKIE_SECURE=false  # Set false when serving over plain HTTP (no TLS yet)

# Error monitoring (optional — Sentry)
# SENTRY_DSN=https://example.ingest.sentry.io/123
# PUBLIC_SENTRY_DSN=https://example.ingest.sentry.io/123
