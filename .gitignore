# Dependencies — always reinstall on the server
node_modules/

# Build / framework output — rebuild with `npm run build`
.svelte-kit/
/build/
.output/
.vercel/
.netlify/
.wrangler/
dist/
coverage/
.turbo/
*.tsbuildinfo

# IDE / local agent (never deploy)
.cursor/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Secrets — copy from .env.example on the server
.env
.env.*
!.env.example
!.env.test

# PocketBase — local DB/files/binary (migrate + download binary on server)
pocketbase/pb_data/
pocketbase/pb_data/**
pocketbase/*.log
pocketbase/pb-stdout.log
pocketbase/pb-stderr.log
pocketbase/pocketbase
pocketbase/pocketbase.exe
pocketbase/pocketbase_*

# Vite cache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tests / Playwright — local only
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/
/e2e/.auth/**

# Dev extract / import scratch (not needed on server)
scripts/neo-pdf-extract.txt
scripts/**/*.pdf
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional local overrides
*.local
!.env.example

# TLS material (generated on server)
nginx/certs/
nginx/certbot/
